# /etc/systemd/system/neurocritter.service
# Приложение слушает только 127.0.0.1:8000; наружу его выставляет Caddy.
[Unit]
Description=Нейрозверёк Недоделок
After=network-online.target
Wants=network-online.target

[Service]
User=nedodelok
Group=nedodelok
WorkingDirectory=/opt/neurocritter/server
EnvironmentFile=/etc/neurocritter.env
ExecStart=/opt/neurocritter/server/.venv/bin/uvicorn app.asgi:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

# ограничения: пишет только в свою папку данных
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neurocritter

[Install]
WantedBy=multi-user.target
