# /etc/neurocritter.env  (права 600, владелец root; в репозиторий настоящий файл не класть)
NEUROCRITTER_DATA=/var/lib/neurocritter
# длинный случайный токен, не короче 16 знаков, только ASCII
NEUROCRITTER_TOKEN=замените-на-свой-длинный-токен
# Провайдер: openai | claude | stub (без интеллектуальных вызовов)
NEUROCRITTER_BRAIN=openai
NEUROCRITTER_PROVIDER=openai
OPENAI_API_KEY=
NEUROCRITTER_MODEL_VOICE=gpt-5.4-mini
NEUROCRITTER_MODEL_NIGHT=gpt-5.4
# При возврате к Claude: NEUROCRITTER_BRAIN=claude, убрать MODEL_* или задать модели Claude.
# ANTHROPIC_API_KEY=
# потолок расходов на API, долларов в месяц
NEUROCRITTER_MONTHLY_LIMIT=5

# Ваш публичный HTTPS-адрес для VAPID (замените example.com)
NEUROCRITTER_VAPID_SUB=https://example.com
